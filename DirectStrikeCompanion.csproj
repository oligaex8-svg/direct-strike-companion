<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Title>Direct Strike Companion</Title>
    <AssemblyTitle>Direct Strike Companion</AssemblyTitle>
    <Product>Direct Strike Companion</Product>
    <Version>1.1.6</Version>
    <UpdateRepository>oligaex8-svg/direct-strike-companion</UpdateRepository>
    <Description>Direct Strike replay library and live lobby companion</Description>
    <ApplicationIcon>assets\companion.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <OcrCaptureCompiler>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\csc.exe</OcrCaptureCompiler>
    <OcrCaptureHelperPath>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\ocr-runtime\DscCaptureHelper.dll</OcrCaptureHelperPath>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
    <Compile Remove="verification\**\*.cs" />
    <Compile Remove="OcrRuntime\DscCapture.cs" />
    <PackageReference Include="Sc2DirectStrike.Parser" Version="0.2.6" />
    <PackageReference Include="s2protocol.NET" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LobbyOcr.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(OcrCaptureHelperPath)" TargetPath="DscCaptureHelper.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="wwwroot\**" LogicalName="DscAsset:%(Identity)" />
    <EmbeddedResource Include="LobbyOcr.ps1" LogicalName="DscTool:LobbyOcr.ps1" />
    <EmbeddedResource Include="$(OcrCaptureHelperPath)" LogicalName="DscTool:DscCaptureHelper.dll" />
    <EmbeddedResource Include="assets\companion.ico" LogicalName="DscBrand:companion.ico" />
    <EmbeddedResource Include="assets\audio\*.wav" LogicalName="DscSound:%(Filename)" />
    <EmbeddedResource Include="assets\audio\catalog.json" LogicalName="DscSoundCatalog" />
    <EmbeddedResource Include="verification\fixtures\sc2-*.json" LogicalName="DscTest:%(Filename)" />
    <EmbeddedResource Include="verification\fixtures\site-profile-3128-current.html" LogicalName="DscTest:site-profile-3128-current" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <Content Update="wwwroot\**;LobbyOcr.ps1;$(OcrCaptureHelperPath)" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="BuildOcrCaptureHelper" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)\OcrRuntime\DscCapture.cs;$(MSBuildProjectFullPath)"
          Outputs="$(OcrCaptureHelperPath)">
    <Error Condition="!Exists('$(OcrCaptureCompiler)')" Text="Building the OCR capture helper requires the Windows .NET Framework compiler: $(OcrCaptureCompiler)" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(OcrCaptureHelperPath)'))" />
    <Exec Command="&quot;$(OcrCaptureCompiler)&quot; /nologo /target:library /optimize+ /debug- /platform:anycpu /reference:&quot;$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Drawing.dll&quot; /out:&quot;$(OcrCaptureHelperPath)&quot; &quot;$(MSBuildProjectDirectory)\OcrRuntime\DscCapture.cs&quot;" />
  </Target>
</Project>
